---
import BaseLayout from "../../layouts/val/BaseLayout.astro";
import { Image } from "astro:assets";

const dibujos = ["dibujo1", "dibujo2", "dibujo3", "dibujo4", "dibujo5"];
---

<BaseLayout title="Dibujos">
    <section class="galeria">
        {
            dibujos.map((d) => (
                <img class="fade-up imagen" src={`/img/${d}.jpg`} />
            ))
        }
    </section>
</BaseLayout>

<style>
    .galeria {
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding: 20px;
    }

    .imagen {
        width: 100%;
        aspect-ratio: 1;

        background: rgb(119, 119, 119);
        padding: 0.5rem;

        border-radius: 16px;

        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
        transition: transform 0.3s ease;
    }

    .imagen:hover {
        transform: translateY(-4px);
    }
</style>
