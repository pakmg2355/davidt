---
import BaseLayout from "../../layouts/val/BaseLayout.astro";
---

<BaseLayout title="Biblioteca">
	<div class="biblioteca-wrapper">
		<header class="biblioteca-header">
			<div class="cabecera-libros">
				<p>El que no entens</p>

				<div class="foto-marco-interior">
					<img
						src="/img/logo_ayri.png"
						alt="Logo"
						class="logo-foto"
					/>
				</div>

				<p>també necessita un lloc</p>
			</div>
		</header>

		<section class="estantes">
			<!-- FILA 1 -->
			<div class="fila-estante">
				<div class="col imagen">
					<h5 class="texto-pantallas fade-up">Portada</h5>
					<img class="img-pantallas" src="/img/portada1.png" />
					<img class="img-pantallas" src="/img/portada2.png" />
					<img class="img-pantallas" src="/img/portada3.png" />
					<img class="img-pantallas" src="/img/portada4.png" />
				</div>

				<div class="col texto">
					<p class="texto-imagen fade-up">
						Hi ha emocions que no sempre s'entenen.
					</p>
					<p class="texto-imagen fade-up">
						A vegades apareixen sense forma, sense nom, sense
						explicació, i quan no s'entenen, no desapareixen: es
						queden dins.
					</p>
					<div class="div-img-movil">
						<img class="img-movil" src="/img/portada1.png" />
						<img class="img-movil" src="/img/contraportada1.png" />
					</div>
					<p class="texto-imagen fade-up">
						Sense nom, sense sortida.
					</p>
					<p class="texto-imagen fade-up">
						Així és on neix la frustració, la ràbia… el desordre. No
						perquè sentes massa, sinó perquè ningú t'ha ensenyat a
						posar nom al que sents.
					</p>
					<p class="texto-imagen fade-up">I Ayri viu allí.</p>
					<p class="texto-imagen fade-up">
						En eixe lloc silenciós entre el que sents i el que
						mostres. On la por, la intuïció i la veritat conviuen
						sense fer soroll. On la confusió emocional no es veu…
						però pesa.
					</p>
					<div class="div-img-movil">
						<img class="img-movil" src="/img/portada2.png" />
						<img class="img-movil" src="/img/contraportada2.png" />
					</div>
					<p class="texto-imagen fade-up">
						Sap quan alguna cosa no. Veurà que el món canvia, i no
						sap on encaixar. No és una heroïna.
					</p>
					<p class="texto-imagen fade-up">
						És un reflex: eixa part que tots tenim i quasi mai
						escoltem. La intuïció que anticipa, la sensibilitat que
						a vegades aclapara, la mirada que a vegades interpreta
						abans de comprendre.
					</p>
					<div class="div-img-movil">
						<img class="img-movil" src="/img/portada3.png" />
						<img class="img-movil" src="/img/contraportada3.png" />
					</div>

					<p class="texto-imagen fade-up">
						Tenir un espai propi ho canvia tot.
					</p>
					<p class="texto-imagen fade-up">
						Un lloc on no cal explicar-se.
					</p>
					<p class="texto-imagen fade-up">
						On pots escriure sense filtres.
					</p>
					<p class="texto-imagen fade-up">
						On el que sents no es jutja… s'entén.
					</p>
					<p class="texto-imagen fade-up">
						És deixar anar i ordenar el que portes dins i convertir
						el soroll en alguna cosa que pots comprendre.
					</p>
					<div class="div-img-movil">
						<img class="img-movil" src="/img/portada4.png" />
						<img class="img-movil" src="/img/contraportada4.png" />
					</div>

					<p class="texto-imagen fade-up">
						Ayri t'acompanyarà en una etapa on tot canvia: quan les
						emocions són intenses, quan apareixen dubtes, quan el
						món comença a semblar més complex.
					</p>
					<p class="texto-imagen fade-up">No dona respostes.</p>
					<p class="texto-imagen fade-up">Però ajuda a trobar-les.</p>
					<p class="texto-imagen fade-up">
						Perquè entendre el que sents també és aprendre a
						expressar-ho.
					</p>
					<p class="texto-imagen fade-up">
						Perquè expressar-ho en paraules és el primer pas per
						comprendre-ho.
					</p>
				</div>

				<div class="col imagen">
					<h5 class="texto-pantallas fade-up">Contraportada</h5>
					<img class="img-pantallas" src="/img/contraportada1.png" />
					<img class="img-pantallas" src="/img/contraportada2.png" />
					<img class="img-pantallas" src="/img/contraportada3.png" />
					<img class="img-pantallas" src="/img/contraportada4.png" />
				</div>
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	/* ---------------- VARIABLES ---------------- */
	:root {
		--fondo: #0f0e0c;
		--tinta: #d6d1c4;
		--tinta-suave: #a8a394;
		--detalle: #b8860b;
	}

	body {
		margin: 0;
		background: var(--fondo);
		font-family: "Georgia", serif;
	}

	.img-pantallas {
		width: 10%;
	}

	.img-movil {
		display: none;
		align-items: center;
		justify-content: space-around;
	}

	/* HEADER */
	.biblioteca-header {
		background: linear-gradient(180deg, #1a1815, #0f0e0c);
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
	}

	.cabecera-libros {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		padding: 0px;
		color: var(--tinta-suave);
	}

	.cabecera-libros p {
		font-size: 1.8rem;
	}

	.logo-foto {
		width: 340px;
		height: 340px;
		object-fit: cover;
	}

	/* ESTANTES */
	.estantes {
		padding: 60px 20px;
		display: flex;
		flex-direction: column;
		gap: 100px;
	}

	/* GRID */
	.fila-estante {
		display: grid;
		grid-template-columns: 260px 1fr 260px;
		gap: 50px;
		align-items: start;
	}

	.fila-estante.invertida {
		grid-template-columns: 260px 1fr 260px;
	}

	.fila-estante.invertida .col.imagen:first-child {
		order: 3;
	}

	.fila-estante.invertida .col.texto {
		order: 2;
	}

	.fila-estante.invertida .col.imagen:last-child {
		order: 1;
	}

	.col.imagen {
		display: flex;
		flex-direction: column;
		gap: 20px;
		align-items: center;
	}

	.col.imagen img {
		width: 100%;
		max-width: 580px;
		filter: brightness(0.9) contrast(1.1);
		transition: 0.3s;
		border-radius: 6px;
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
	}

	.col.imagen img:hover {
		transform: scale(1.05);
	}

	/* TEXTO */
	.col.texto {
		width: 100%;
	}

	.texto-imagen {
		color: var(--tinta-suave);
		font-size: 1.25rem;
		line-height: 1.9;
		text-align: justify;
		margin-bottom: 22px;
		letter-spacing: 0.3px;
	}

	.texto-imagen.inicio::first-letter {
		font-size: 3rem;
		float: left;
		padding-right: 8px;
		color: var(--detalle);
		font-weight: bold;
	}

	.texto-imagen.final {
		color: var(--tinta);
		font-style: italic;
		text-align: center;
		margin-top: 40px;
	}

	.texto-pantallas {
		color: var(--tinta);
		font-size: 1rem;
		letter-spacing: 2px;
		text-transform: uppercase;
		text-align: center;
		margin-bottom: 10px;
		opacity: 0.8;
	}

	/* RESPONSIVE */
	@media (max-width: 900px) {
		.texto-pantallas {
			display: none;
		}

		.div-img-movil {
			display: flex;
			align-items: center;
			justify-content: space-around;
			width: 100%;
		}
		.img-movil {
			display: flex;
			align-items: center;
			justify-content: space-around;
			width: 40vw;
		}
		.img-pantallas {
			display: none !important;
		}
		.cabecera-libros {
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 10px;
			padding: 10px;
			color: var(--tinta-suave);
		}

		.fila-estante {
			grid-template-columns: 1fr;
			gap: 30px;
			text-align: center;
		}

		.fila-estante.invertida .col {
			order: unset;
		}

		.texto-imagen {
			text-align: justify;
		}
	}
</style>
