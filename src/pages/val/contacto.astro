---
import BaseLayout from "../../layouts/val/BaseLayout.astro";
---

<BaseLayout title="Contacto">
	<div class="contacto-wrapper">
		<div class="fondo-decorativo" aria-hidden="true">
			<span class="fondo-letra">C</span>
		</div>

		<main class="contacto-contenido">
			<div class="contacto-cabecera">
				<p class="contacto-etiqueta">Escriume</p>
				<h1 class="contacto-titulo">Contacte</h1>
				<div class="contacto-divisor">
					<span class="divisor-ala"></span>
					<span class="divisor-simbolo">❧</span>
					<span class="divisor-ala"></span>
				</div>
				<p class="contacto-descripcion">
					Si vols posar-te en contacte amb mi, completa el formulari o
					utilitza les dades següents. Responc personalment a cada
					missatge.
				</p>
			</div>

			<form
				class="contacto-form contacto-cuerpo"
				name="contacto"
				method="POST"
				data-netlify="true"
			>
				<input type="hidden" name="form-name" value="contacto" />
				<input type="text" name="bot-field" style="display:none" />

				<div class="campo-grupo campo-grupo--mitad">
					<div class="campo">
						<label class="campo-label" for="nombre">Nom</label>
						<input
							class="campo-input"
							type="text"
							id="nombre"
							name="nombre"
							placeholder="Tu nombre"
							required
						/>
					</div>
					<div class="campo">
						<label class="campo-label" for="email">Email</label>
						<input
							class="campo-input"
							type="email"
							id="email"
							name="email"
							placeholder="tu@email.com"
							required
						/>
					</div>
				</div>

				<div class="campo">
					<label class="campo-label" for="asunto">Asumpte</label>
					<input
						class="campo-input"
						type="text"
						id="asunto"
						name="asunto"
						placeholder="Motivo del mensaje"
					/>
				</div>

				<div class="campo">
					<label class="campo-label" for="mensaje">Missatge</label>
					<textarea
						class="campo-input campo-textarea"
						id="mensaje"
						name="mensaje"
						placeholder="Escribe tu mensaje aquí..."
						required></textarea>
				</div>

				<div class="form-pie">
					<button class="form-btn" type="submit">
						<span class="btn-texto">Enviar missatge</span>
						<span class="btn-flecha">→</span>
					</button>
				</div>
			</form>

			<aside class="contacto-lateral">
				<div class="lateral-ornamento">
					<span class="lat-linea"></span>
					<span class="lat-rombo">◆</span>
					<span class="lat-linea"></span>
				</div>

				<div class="lateral-bloque">
					<p class="lateral-label">Email</p>
					<a class="lateral-valor" href="mailto:hola@ejemplo.com"
						>hola@exemple.com</a
					>
				</div>

				<div class="lateral-separador"></div>

				<div class="lateral-bloque">
					<p class="lateral-label">Xarxes</p>
					<div class="lateral-redes">
						<a
							class="lateral-red"
							href="#"
							target="_blank"
							rel="noopener noreferrer">Instagram</a
						>
						<a
							class="lateral-red"
							href="#"
							target="_blank"
							rel="noopener noreferrer">Twitter / X</a
						>
						<a
							class="lateral-red"
							href="#"
							target="_blank"
							rel="noopener noreferrer">LinkedIn</a
						>
					</div>
				</div>

				<div class="lateral-cita">
					<p class="cita-texto">
						Tota gran conversa comença amb un primer missatge.
					</p>
				</div>
			</aside>
		</main>
	</div>
</BaseLayout>

<style>
	.contacto-wrapper {
		background-color: var(--crema);
		display: flex;
		align-items: center; /* antes tenías 'top', que no existe */
		justify-content: flex-start; /* opcional si quieres que empiece desde la izquierda */
		min-height: 90vh;
		width: 100vw;
		color: var(--carbon);
		position: relative;
		overflow: hidden;
	}

	/* CONTENIDO */
	.contacto-contenido {
		position: relative;
		z-index: 1;
		max-width: 1000px;
		margin: 0 auto;
		padding: 5rem 3rem 6rem;
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	/* CABECERA */
	.contacto-cabecera {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0;
	}

	.contacto-etiqueta {
		letter-spacing: 0.4em;
		text-transform: uppercase;
		color: var(--ocre);
		margin-bottom: 0.6rem;
	}

	.contacto-titulo {
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--carbon);
		line-height: 1;
		margin-bottom: 1.5rem;
	}

	.contacto-divisor {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		width: 140px;
		margin-bottom: 1.5rem;
	}

	.divisor-ala {
		flex: 1;
		height: 1px;
		background: var(--linea);
	}

	.divisor-simbolo {
		color: var(--ocre);
		line-height: 1;
	}

	.contacto-descripcion {
		line-height: 1.9;
		color: var(--tinta-suave);
		max-width: 500px;
	}

	/* CUERPO: FORMULARIO + LATERAL */
	.contacto-cuerpo {
		display: grid;
		grid-template-columns: 1fr 260px;
		gap: 4rem;
		align-items: start;
		border-top: 1px solid var(--linea);
		padding-top: 3rem;
	}

	/* FORMULARIO */
	.contacto-form {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}

	.campo-grupo--mitad {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem;
	}

	.campo {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.campo-label {
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--tinta-suave);
	}

	.campo-input {
		background: transparent;
		border: none;
		border-bottom: 1px solid var(--linea);
		padding: 0.6rem 0;

		color: var(--carbon);
		width: 100%;
		outline: none;
		transition: border-color 0.25s;
		border-radius: 0;
		-webkit-appearance: none;
	}

	.campo-input::placeholder {
		color: var(--linea);
	}

	.campo-input:focus {
		border-bottom-color: var(--ocre);
	}

	.campo-textarea {
		min-height: 140px;
		resize: none;
		line-height: 1.7;
		padding-top: 0.4rem;
	}

	.form-pie {
		display: flex;
		align-items: center;
		padding-top: 0.5rem;
	}

	.form-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		background: var(--carbon);
		color: var(--blanco);
		border: none;
		padding: 0.9rem 2.2rem;

		letter-spacing: 0.25em;
		text-transform: uppercase;
		cursor: pointer;
		position: relative;
		transition: background 0.25s;
	}

	.form-btn::before {
		content: "";
		position: absolute;
		inset: -3px;
		border: 1px solid var(--linea);
		pointer-events: none;
		transition: inset 0.2s;
	}

	.form-btn:hover {
		background: var(--ocre);
	}

	.form-btn:hover::before {
		inset: -5px;
	}

	.btn-flecha {
		transition: transform 0.2s;
	}

	.form-btn:hover .btn-flecha {
		transform: translateX(5px);
	}

	/* LATERAL */
	.contacto-lateral {
		display: flex;
		flex-direction: column;
		gap: 0;
		padding-left: 2.5rem;
		border-left: 1px solid var(--linea);
	}

	.lateral-ornamento {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1.75rem;
	}

	.lat-linea {
		flex: 1;
		height: 1px;
		background: var(--linea);
	}

	.lat-rombo {
		color: var(--ocre);
	}

	.lateral-bloque {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		margin-bottom: 1.25rem;
	}

	.lateral-label {
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--ocre);
	}

	.lateral-valor {
		color: var(--carbon);
		text-decoration: none;
		border-bottom: 1px solid transparent;
		transition:
			border-color 0.2s,
			color 0.2s;
		width: fit-content;
	}

	.lateral-valor:hover {
		color: var(--ocre);
		border-bottom-color: var(--ocre);
	}

	.lateral-valor--normal {
		color: var(--tinta-suave);
		line-height: 1.6;
	}

	.lateral-redes {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.lateral-red {
		color: var(--tinta);
		text-decoration: none;
		border-bottom: 1px solid transparent;
		transition:
			color 0.2s,
			border-color 0.2s;
		width: fit-content;
	}

	.lateral-red:hover {
		color: var(--ocre);
		border-bottom-color: var(--ocre);
	}

	.lateral-separador {
		height: 1px;
		background: var(--linea);
		margin: 1rem 0 1.25rem;
	}

	.lateral-cita {
		margin-top: 2rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--linea);
		position: relative;
	}

	.cita-comilla {
		color: var(--linea);
		line-height: 0.5;
		display: block;
		margin-bottom: 0.75rem;
	}

	.cita-texto {
		font-style: italic;
		text-align: justify;
		color: var(--tinta-suave);
		line-height: 1.6;
	}

	.firma-texto {
		letter-spacing: 0.4em;
		text-transform: uppercase;
		color: var(--linea);
		white-space: nowrap;
	}

	/* FOOTER */
	.biblioteca-footer {
		background: linear-gradient(180deg, var(--crema), var(--crema-oscura));
		border-bottom: 1px solid var(--linea);
		align-items: center;
		padding: 20px;
	}

	/* RESPONSIVE */
	@media (max-width: 800px) {
		.contacto-contenido {
			padding: 4rem 2rem 5rem;
			gap: 2.5rem;
		}

		.contacto-cuerpo {
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		.contacto-lateral {
			padding-left: 0;
			border-left: none;
			border-top: 1px solid var(--linea);
			padding-top: 2rem;
		}
	}

	@media (max-width: 520px) {
		.campo-grupo--mitad {
			grid-template-columns: 1fr;
		}

		.contacto-contenido {
			padding: 3rem 1.5rem 4rem;
		}
	}
</style>
