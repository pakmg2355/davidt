---
import BaseLayout from "../../layouts/es/BaseLayout.astro";
---

<BaseLayout title="Biblioteca">
	<div class="biblioteca-wrapper">
		<header class="biblioteca-header">
			<div class="cabecera-libros">
				<p>Lo que no entiendes</p>

				<div class="foto-marco-interior">
					<img
						src="/img/logo_ayri.png"
						alt="Logo"
						class="logo-foto"
					/>
				</div>

				<p>también necesita un lugar</p>
			</div>
		</header>

		<section class="estantes">
			<!-- FILA 1 -->
			<div class="fila-estante">
				<div class="col imagen">
					<h5 class="texto-pantallas fade-up">Portada</h5>
					<img class="img-pantallas" src="/img/portada1.png" />
					<img class="img-pantallas" src="/img/portada2.png" />
					<img class="img-pantallas" src="/img/portada3.png" />
					<img class="img-pantallas" src="/img/portada4.png" />º
				</div>

				<div class="col texto">
					<p class="texto-imagen fade-up">
						Hay emociones que no siempre se entienden.
					</p>
					<p class="texto-imagen fade-up">
						A veces aparecen sin forma, sin nombre, sin explicación,
						y cuando no se entienden, no desaparecen: se quedan
						dentro.
					</p>
					<div class="div-img-movil">
						<img class="img-movil" src="/img/portada1.png" />
						<img class="img-movil" src="/img/contraportada1.png" />
					</div>
					<p class="texto-imagen fade-up">Sin nombre, sin salida.</p>
					<p class="texto-imagen fade-up">
						Es ahí donde nace la frustración, la rabia… el desorden.
						No porque sientas demasiado, sino porque nadie te enseñó
						a poner nombre a lo que sientes.
					</p>
					<p class="texto-imagen fade-up">Y Ayri vive ahí.</p>
					<p class="texto-imagen fade-up">
						En ese lugar silencioso entre lo que sientes y lo que
						muestras. Donde el miedo, la intuición y la verdad
						conviven sin hacer ruido. Donde la confusión emocional
						no se ve… pero pesa.
					</p>
					<div class="div-img-movil">
						<img class="img-movil" src="/img/portada2.png" />
						<img class="img-movil" src="/img/contraportada2.png" />
					</div>
					<p class="texto-imagen fade-up">
						Sabe cuándo algo no. Ve que el mundo cambia, y no sabe
						dónde encajar. No es una heroína.
					</p>
					<p class="texto-imagen fade-up">
						Es un reflejo: esa parte que todos tenemos y casi nunca
						escuchamos. La intuición que anticipa, la sensibilidad
						que a veces abruma, la mirada que a veces interpreta
						antes de comprender.
					</p>
					<div class="div-img-movil">
						<img class="img-movil" src="/img/portada3.png" />
						<img class="img-movil" src="/img/contraportada3.png" />
					</div>

					<p class="texto-imagen fade-up">
						Tener un espacio propio lo cambia todo.
					</p>
					<p class="texto-imagen fade-up">
						Un lugar donde no hace falta explicarse.
					</p>
					<p class="texto-imagen fade-up">
						Donde puedes escribir sin filtros.
					</p>
					<p class="texto-imagen fade-up">
						Donde lo que sientes no se juzga… se entiende.
					</p>
					<p class="texto-imagen fade-up">
						Es soltar y ordenar lo que llevas dentro y convertir el
						ruido en algo que puedes comprender.
					</p>
					<div class="div-img-movil">
						<img class="img-movil" src="/img/portada4.png" />
						<img class="img-movil" src="/img/contraportada4.png" />
					</div>

					<p class="texto-imagen fade-up">
						Ayri te acompañará en una etapa donde todo cambia:
						cuando las emociones son intensas, cuando aparecen
						dudas, cuando el mundo empieza a sentirse más complejo.
					</p>
					<p class="texto-imagen fade-up">No da respuestas.</p>
					<p class="texto-imagen fade-up">
						Pero ayuda a encontrarlas.
					</p>
					<p class="texto-imagen fade-up">
						Porque entender lo que sientes también es aprender a
						expresarlo.
					</p>
					<p class="texto-imagen fade-up">
						Porque expresarlo en palabras es el primer paso para
						entenderlo.
					</p>
				</div>

				<div class="col imagen">
					<h5 class="texto-pantallas fade-up">Contraportada</h5>
					<img class="img-pantallas" src="/img/contraportada1.png" />
					<img class="img-pantallas" src="/img/contraportada2.png" />
					<img class="img-pantallas" src="/img/contraportada3.png" />
					<img class="img-pantallas" src="/img/contraportada4.png" />
				</div>
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	:root {
		--fondo: #0f0e0c;
		--tinta: #d6d1c4;
		--tinta-suave: #a8a394;
		--detalle: #b8860b;
	}

	body {
		margin: 0;
		background: var(--fondo);
		font-family: "Georgia", serif;
	}

	.img-pantallas {
		width: 10%;
	}

	.img-movil {
		display: none;
		align-items: center;
		justify-content: space-around;
	}

	/* HEADER */

	.biblioteca-header {
		background: linear-gradient(180deg, #1a1815, #0f0e0c);
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
	}

	.cabecera-libros {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		padding: 0px;
		color: var(--tinta-suave);
	}

	.cabecera-libros p {
		font-size: 1.8rem;
	}

	.logo-foto {
		width: 340px;
		height: 340px;
		object-fit: cover;
	}

	/* ESTANTES */
	.estantes {
		padding: 60px 20px;
		display: flex;
		flex-direction: column;
		gap: 100px;
	}

	/* GRID */
	.fila-estante {
		display: grid;
		grid-template-columns: 260px 1fr 260px;
		gap: 50px;
		align-items: start;
	}

	/* 🔥 INVERSIÓN AUTOMÁTICA */
	.fila-estante.invertida {
		grid-template-columns: 260px 1fr 260px;
	}

	.fila-estante.invertida .col.imagen:first-child {
		order: 3;
	}

	.fila-estante.invertida .col.texto {
		order: 2;
	}

	.fila-estante.invertida .col.imagen:last-child {
		order: 1;
	}

	.col.imagen {
		display: flex;
		flex-direction: column; /* 🔥 ESTO ES LO QUE FALTA */
		gap: 20px;
		align-items: center;
	}

	/* IMÁGENES */
	.col.imagen img {
		width: 100%;
		max-width: 580px; /* 👈 más pequeñas para que quepan 4 */
		filter: brightness(0.9) contrast(1.1);
		transition: 0.3s;
	}

	.col.imagen img {
		border-radius: 6px;
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
	}

	.col.imagen img:hover {
		transform: scale(1.05);
	}

	/* TEXTO */
	.col.texto {
		width: 100%;
	}

	.texto-imagen {
		color: var(--tinta-suave);
		font-size: 1.25rem;
		line-height: 1.9;
		text-align: justify;
		margin-bottom: 22px;
		letter-spacing: 0.3px;
	}

	/* LETRA CAPITULAR */
	.texto-imagen.inicio::first-letter {
		font-size: 3rem;
		float: left;
		padding-right: 8px;
		color: var(--detalle);
		font-weight: bold;
	}

	/* FINAL */
	.texto-imagen.final {
		color: var(--tinta);
		font-style: italic;
		text-align: center;
		margin-top: 40px;
	}

	.texto-pantallas {
		color: var(--tinta);
		font-size: 1rem;
		letter-spacing: 2px;
		text-transform: uppercase;
		text-align: center;
		margin-bottom: 10px;
		opacity: 0.8;
	}

	/* RESPONSIVE */
	@media (max-width: 900px) {
		.texto-pantallas {
			display: none;
		}

		.div-img-movil {
			display: flex;
			align-items: center;
			justify-content: space-around;
			width: 100%;
		}
		.img-movil {
			display: flex;
			align-items: center;
			justify-content: space-around;
			width: 40vw;
		}
		.img-pantallas {
			display: none !important;
		}
		.cabecera-libros {
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 10px;
			padding: 10px;
			color: var(--tinta-suave);
		}

		.fila-estante {
			grid-template-columns: 1fr;
			gap: 30px;
			text-align: center;
		}

		.fila-estante.invertida .col {
			order: unset;
		}

		.texto-imagen {
			text-align: justify;
		}
	}
</style>
