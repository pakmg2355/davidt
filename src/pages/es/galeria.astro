---
import BaseLayout from "../../layouts/es/BaseLayout.astro";

const imagenes = Object.values(
    import.meta.glob<{ default: ImageMetadata }>("/src/assets/dibujos/*.jpg", {
        eager: true,
    }),
);
---

<BaseLayout title="Dibujos">
    <section class="galeria">
        {
            imagenes.map((img) => (
                <img
                    class="fade-up imagen"
                    src={img.default.src}
                    alt="Dibujo"
                />
            ))
        }
    </section>
</BaseLayout>

<style>
    .galeria {
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding: 20px;
        align-items: center;
    }

    .imagen {
        width: 60%;
        aspect-ratio: 1;

        background: rgb(119, 119, 119);
        padding: 0.5rem;

        border-radius: 16px;

        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
        transition: transform 0.3s ease;
        align-items: center;
    }

    .imagen:hover {
        transform: translateY(-4px);
    }
</style>
