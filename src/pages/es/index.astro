---
import BaseLayout from "../../layouts/es/BaseLayout.astro";

import bioData from "../../data/bio.json";
---

<BaseLayout title="El autor">
    <section class="index">
        <img src="/img/davidt.jpg" />

        <div class="autor-texto">
            {
                bioData.map((item) => (
                    <>
                        <h2>{item.titulo_es}</h2>
                        <p>{item.bio_es}</p>
                    </>
                ))
            }
        </div>
    </section>
</BaseLayout>

<style>
    .index {
        display: flex;
        flex-direction: column;
        align-items: center; /* centra horizontalmente los hijos si son más pequeños */
        gap: 1.5rem;
        padding: 2rem 1rem;
        min-width: 50%; /* nunca menor al 50% del contenedor padre */
        width: 80vw; /* ancho base */
        margin: 0 auto; /* centra el section */
    }
</style>
